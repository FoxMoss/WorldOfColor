code = "shader_type canvas_item;
uniform float bubblelevel : hint_range(0, 1) = 0;



void vertex() {
// Output:0

}

void fragment() {
// Input:3
	vec3 n_out3p0 = vec3(UV, 0.0);

// VectorDecompose:4
	float n_out4p0 = n_out3p0.x;
	float n_out4p1 = n_out3p0.y;
	float n_out4p2 = n_out3p0.z;

// ScalarOp:6
	float n_in6p1 = 20.00000;
	float n_out6p0 = n_out4p0 * n_in6p1;

// Input:9
	float n_out9p0 = TIME;

// ScalarOp:13
	float n_in13p1 = 10.00000;
	float n_out13p0 = n_out9p0 * n_in13p1;

// ScalarOp:12
	float n_out12p0 = n_out6p0 + n_out13p0;

// ScalarFunc:2
	float n_out2p0 = sin(n_out12p0);

// Scalar:18
	float n_out18p0 = 20.000000;

// ScalarOp:8
	float n_out8p0 = n_out4p1 * n_out18p0;

// ScalarUniform:16
	float n_out16p0 = bubblelevel;

// ScalarOp:20
	float n_out20p0 = n_out16p0 * n_out18p0;

// ScalarOp:17
	float n_in17p1 = -1.00000;
	float n_out17p0 = n_out20p0 * n_in17p1;

// ScalarOp:7
	float n_out7p0 = n_out8p0 + n_out17p0;

// Compare:5
	bool n_out5p0 = n_out2p0<n_out7p0;

// Distance:14
	vec3 n_in14p0 = vec3(0.50000, 0.50000, 0.00000);
	float n_out14p0 = distance(n_in14p0, n_out3p0);

// Compare:15
	float n_in15p1 = 0.50000;
	bool n_out15p0 = n_out14p0>n_in15p1;

// Compare:11
	bool n_out11p0 = (n_out5p0 ? 1.0 : 0.0)>(n_out15p0 ? 1.0 : 0.0);

// Output:0
	COLOR.a = (n_out11p0 ? 1.0 : 0.0);

}

